# Environment Variables — File-based pipeline (no ClickHouse required)

# Local data directory for CSV/JSON output
DATA_DIR=data

# Slack Webhook URLs (optional)
SLACK_DAILY_PULSE_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEEKLY_DIGEST_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Amazon scraper
# auto = requests first, Playwright if page has no products; always | never
AMAZON_USE_PLAYWRIGHT=auto
# Optional paid fallback
# APIFY_API_TOKEN=your_apify_token_here
# APIFY_ACTOR_ID=m-murasovs/amazon-bestsellers-scraper

# Flipkart open-source API (docker compose service flipkart-scraper)
FLIPKART_SCRAPER_URL=http://localhost:3001

# General
# production | prod blocks sample fallbacks and --skip-scrape
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Dashboard (local + Render)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Render sets PORT automatically; leave DASHBOARD_PORT unset on Render

# --- Optional: ClickHouse (docker compose --profile warehouse) ---
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=default
